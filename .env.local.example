NEXT_PUBLIC_N8N_WEBHOOK_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# OKR read-only view (Google Sheets service account, view/Viewer access is
# enough — the dashboard never writes back) — see CONTEXT.md for setup steps.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=1OJk2cqTmwS1_GBhJL_U67-fzH-gqkfqD2ODBzFb_0kU

# Instagram Analytics module (Supabase Postgres, separate from the KV funnel
# pipeline above) — see CLAUDE.md "Instagram Analytics module" section and
# db/migrations/001_social_init.sql. SUPABASE_SERVICE_ROLE_KEY is server-only,
# same rule as KV_REST_API_TOKEN — never expose it to the client bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Meta Developer App (Business type, Facebook Login flavor — IG account must
# be linked to a Facebook Page). Used by the n8n social-* workflows, not by
# the Next.js app directly.
META_APP_ID=
META_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=
FB_PAGE_ID=
