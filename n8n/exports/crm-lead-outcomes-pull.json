        {
            "id": "classify",
            "name": "Classify Pull Result",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                880,
                0
            ],
            "parameters": {
                "jsCode": "// With fullResponse+neverError, output is { statusCode, headers, body }.\n// A thrown node error (DNS failure, timeout, malformed URL \u2014 e.g. the\n// placeholder CRM_BASE_URL never being replaced) lands here as $json with no\n// statusCode at all; treat that the same as a network failure, never as\n// \"zero events\". See CONTEXT.md: 401/404/timeout are failures with a reason,\n// not empty successes.\nconst item = $input.first().json;\nconst statusCode = item.statusCode;\n\nif (statusCode === undefined) {\n  return [{ json: { ok: false, reason: item.error || item.message || 'request did not complete (network/timeout error)' } }];\n}\nif (statusCode === 200) {\n  const body = item.body;\n  const events = Array.isArray(body) ? body : (Array.isArray(body && body.events) ? body.events : null);\n  if (!events) {\n    return [{ json: { ok: false, reason: `200 response body was not the expected array shape: ${JSON.stringify(body).slice(0, 200)}` } }];\n  }\n  return [{ json: { ok: true, events } }];\n}\nif (statusCode === 404) {\n  return [{ json: { ok: false, reason: 'CRM endpoint returned 404 \u2014 not live yet (expected until the CRM confirms deployment)' } }];\n}\nif (statusCode === 401 || statusCode === 403) {\n  return [{ json: { ok: false, reason: `CRM endpoint returned ${statusCode} \u2014 token rejected, check the CRM Lead Outcomes Token credential` } }];\n}\nreturn [{ json: { ok: false, reason: `CRM endpoint returned unexpected status ${statusCode}` } }];"
            }
        },
        {
            "id": "ifOk",
            "name": "Pull Succeeded?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2,
            "position": [
                1100,
                0
            ],
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "c1",
                            "leftValue": "={{ $json.ok }}",
                            "rightValue": true,
                            "operator": {
                                "type": "boolean",
                                "operation": "true",
                                "singleValue": true
                            }
                        }
                    ],
                    "combinator": "and"
                }
            }
        },
        {
            "id": "prepareRows",
            "name": "Prepare Outcome Rows",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1320,
                -120
            ],
            "parameters": {
                "jsCode": "// Reserved event type QualifiedLead and any type name not yet in\n// lib/crm/events.ts's canonical list are still stored, never dropped \u2014 an\n// unrecognized event is data loss risk, not something to silently filter.\nconst events = $json.events;\nconst rows = events\n  .filter(e => e && e.response_id && e.event && e.occurred_at)\n  .map(e => ({ response_id: String(e.response_id), event: String(e.event), occurred_at: e.occurred_at }));\n\nconst eventTypesObserved = [...new Set(rows.map(r => r.event))];\n\nlet maxOccurredAt = null;\nfor (const r of rows) {\n  if (!maxOccurredAt || new Date(r.occurred_at) > new Date(maxOccurredAt)) maxOccurredAt = r.occurred_at;\n}\n// No new rows this pull: don't rewind the cursor to null \u2014 keep whatever\n// Build Since Param read, so an empty response never re-requests a window\n// already confirmed clear.\nconst previousSince = $('Build Since Param').first().json.since;\nconst nextCursor = maxOccurredAt || previousSince || new Date().toISOString();\n\nconst eventsInFilter = '(' + eventTypesObserved.map(e => `\"${e.replace(/\"/g, '')}\"`).join(',') + ')';\n\nreturn [{ json: { rows, eventTypesObserved, eventsInFilter, nextCursor, count: rows.length } }];"
            }
        },
