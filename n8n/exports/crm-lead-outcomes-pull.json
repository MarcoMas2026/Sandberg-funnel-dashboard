            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                660,
                0
            ],
            "parameters": {
                "url": "https://REPLACE-WITH-CRM-BASE-URL/api/intelligence/lead-outcomes",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendQuery": true,
                "queryParameters": {
                    "parameters": [
                        {
                            "name": "since",
                            "value": "={{ $json.since || undefined }}"
                        }
                    ]
                },
                "options": {
                    "timeout": 20000,
                    "response": {
