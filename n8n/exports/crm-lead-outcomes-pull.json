            ],
            "parameters": {
                "jsCode": "// crm_sync_state is a single-row table; Supabase REST returns an array.\nconst row = ($input.first().json || [])[0] || null;\nconst since = row && row.last_success_cursor ? row.last_success_cursor : null;\nreturn [{ json: { since } }];"
